# ============================================================================
# Johor Studio — Photo Order  ·  environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# ============================================================================

# --- App ---
APP_NAME="Johor Studio"
APP_ENV=production                       # production | development
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=https://shop.johorstudio.com
TIMEZONE=Asia/Kuala_Lumpur
DEFAULT_LANG=ms                          # ms | en  (UI is bilingual, toggle in nav)

# --- Paths (on the TrueNAS host) ---
# Code lives in /mnt/ssd/website-order ; persistent data below.
DATA_DIR=/mnt/a/storage/website/print purchase
SQLITE_PATH=/mnt/a/storage/website/print purchase/SQlite/app.sqlite3
# Sub-dirs created automatically under DATA_DIR: cache/ receipts/ trash/ backups/

# --- Nextcloud (WebDAV) ---
NEXTCLOUD_BASE_URL=https://cloud.johorstudio.com
NEXTCLOUD_USER=galeri-bot
NEXTCLOUD_APP_PASSWORD=                   # Nextcloud app password for galeri-bot
# WebDAV root for this user; originals are read-only, print output is written here:
NEXTCLOUD_WEBDAV_ROOT=/remote.php/dav/files/galeri-bot
NEXTCLOUD_PRINT_FOLDER=Untuk-Cetak        # relative to WebDAV root

# --- Payment (manual) ---
PAY_QRPAY_BANK=Maybank
PAY_QRPAY_IMAGE=                          # optional: /static/img/qrpay.png (static QR you upload)
PAY_BANK_NAME=Bank Muamalat
PAY_BANK_ACCOUNT_NAME=PROMEDIA CREATIVE SOLUTIONS
PAY_BANK_ACCOUNT_NO=                      # your Bank Muamalat account number

# Dynamic DuitNow QR (generated per order, with amount + phone reference)
# Decode your printed STATIC DuitNow QR once (any QR reader) and paste the full
# EMVCo string here. The app switches it to dynamic, injects the order amount and
# the customer's phone as reference, and recomputes the CRC.
# NOTE: this only pre-fills the payer's app — it does NOT auto-confirm payment
# (receipt OCR still confirms). Test with a few banks/e-wallets before relying on it.
DUITNOW_ENABLED=false
DUITNOW_STATIC_PAYLOAD=
DUITNOW_REF_SUBTAG=05                     # Tag 62 subtag for reference (05 = Reference Label)

# --- Postage (RM) — seed defaults, editable per event in admin ---
POSTAGE_WEST=10
POSTAGE_EAST=18                           # Sabah / Sarawak

# --- Receipt / OCR ---
RECEIPT_MAX_MB=10
RECEIPT_WEBP_QUALITY=50
TRASH_RETENTION_DAYS=90
OCR_ENABLED=true                          # set false to skip PaddleOCR (admin reads manually)

# --- Google Sheets (service account) ---
GOOGLE_SA_JSON=/mnt/a/storage/website/print purchase/google-service-account.json
GSHEET_PARENT_FOLDER_ID=                  # Drive folder (shared with the SA email) for job-list sheets

# --- Email (SMTP relay) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM="Johor Studio <order@johorstudio.com>"

# --- WhatsApp ---
WHATSAPP_NUMBER=60127983745               # international format, no +

# --- Login / sessions ---
LOGIN_CODE_TTL_SECONDS=600                # how long an emailed code is valid
LOGIN_RESEND_SECONDS=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_DAYS=30

# --- Admin ---
# Admin pages live under /admin and are protected by Cloudflare Access (no app login).
# Cloudflare sends the authenticated user's email in this header; used only for the audit log.
ADMIN_EMAIL_HEADER=Cf-Access-Authenticated-User-Email

# --- Analytics (Umami, self-hosted on TrueNAS) ---
UMAMI_SRC=                                # e.g. https://umami.johorstudio.com/script.js
UMAMI_WEBSITE_ID=

# --- Backups ---
BACKUP_KEEP_DAYS=14
